# Build output
build/
*.o
*.a
*.so
*.d

# Packet captures taken while debugging (⚠ they can contain real traffic)
*.pcap
*.pcapng

# Development telemetry (written by .claude/hooks/telemetry.mjs).
# ⚠ This is the record of how work was handed to the AI, not anything the product emits.
# ⚠ It never leaves this machine and it never enters git.
# ⚠ The exact string below is also declared in .claude/telemetry-dir.mjs
#   (TELEMETRY_IGNORE_LINE). ⚠ If you change one, change the other.
.claude/telemetry/

# Local secrets read by .claude/hooks/ask-slack.mjs
.env
.envrc
